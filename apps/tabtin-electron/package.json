  "build": {
    "appId": "com.zhifangfang.app.local",
    "productName": "智算方舟",
    "publish": {
      "provider": "generic",
      "url": "http://127.0.0.1:6060/desktop-updates"
    },
    "directories": {
      "output": "dist-app"
    },
    "files": [
      "out/**/*",
      "static/icon.png",
      "static/icon-preprod.png",
