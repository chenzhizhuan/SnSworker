{
  "name": "tabtin-electron",
  "version": "1.0.1",
  "description": "智算方舟 Agent-first unified work platform desktop application",
  "type": "module",
  "main": "out/main/index.mjs",
  "private": true,
  "scripts": {
    "build:workspace": "node ../../scripts/electron/run-predev-build-with-lock.mjs",
    "check:store-conventions": "node scripts/check-store-conventions.mjs",
    "check:i18n": "node scripts/check-i18n-completeness.mjs",
    "predev": "node scripts/prepare-dev-runtime.mjs",
    "predev:preprod": "node scripts/prepare-dev-runtime.mjs",
    "predev:no-hmr": "node scripts/prepare-dev-runtime.mjs",
    "prebuild": "pnpm run typecheck && pnpm run check:i18n",
    "pretypecheck": "pnpm run build:workspace",
    "pretypecheck:test": "pnpm run build:workspace",
    "pretypecheck:fast": "pnpm run build:workspace",
    "postinstall": "electron-rebuild -f --only node-pty --module-dir .",
    "bootstrap": "node ../../scripts/electron/install-dependencies.mjs --region global",
    "bootstrap:cn": "node ../../scripts/electron/install-dependencies.mjs --region cn",
    "bootstrap:doctor": "node ../../scripts/electron/install-dependencies.mjs --doctor",
    "dev": "node ../../scripts/electron/dev.mjs",
    "dev:community": "node ../../scripts/dev.mjs community",
    "dev:no-hmr": "node ../../scripts/electron/dev.mjs --no-hmr",
    "dev:all": "./start-dev.sh",
    "build": "node scripts/run-electron-vite.mjs build",
    "build:report": "node scripts/build-report.mjs",
    "icons:generate": "node scripts/generate-app-icons.mjs",
    "dmg:background": "node scripts/generate-dmg-background.mjs",
    "preview": "electron-vite preview",
    "preview:packaged": "electron-vite preview --skipBuild",
    "runtimes:fetch": "bash ../../scripts/electron/runtime/fetch-desktop-runtimes.sh",
    "build:mac:local": "bash scripts/build-packaged-app.sh mac local",
    "build:mac:local:arm64": "bash scripts/build-packaged-app.sh mac local arm64",
    "build:mac:local:x64": "bash scripts/build-packaged-app.sh mac local x64",
    "build:mac:dmg:quick": "bash scripts/build-mac-dmg-quick.sh",
    "build:win:local": "bash scripts/build-packaged-app.sh win local x64",
    "build:win:community:x86": "bash scripts/build-packaged-app.sh win community ia32",
    "build:win:local:quick": "bash scripts/build-win-nsis-quick.sh local x64",
    "build:linux:local": "bash scripts/build-packaged-app.sh linux local x64",
    "build:win:community": "bash scripts/build-packaged-app.sh win community x64",
    "build:mac:community": "bash scripts/build-packaged-app.sh mac community",
    "build:linux:community": "bash scripts/build-packaged-app.sh linux community x64",
    "audit:opensource": "node scripts/open-source-client-audit.mjs",
    "test:opensource-docs": "node --test scripts/open-source-docs-contract.test.mjs",
    "audit:packaged": "node scripts/audit-packaged-artifact.mjs",
    "test:install-identity": "node scripts/install-identity-contract.test.cjs",
    "release:publish": "node scripts/publish-desktop-release.cjs",
    "release:go-live": "node scripts/confirm-desktop-go-live.cjs",
    "release:verify-upload-flow": "node scripts/verify-publish-desktop-release-flow.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:fast": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:agent": "vitest run src/main/agent",
    "test:auth": "vitest run --reporter=verbose src/__tests__/auth/",
    "lint": "eslint src/"
  },
  "keywords": [
    "electron",
    "tabtin",
    "ai",
    "content-collection",
    "data-extraction",
    "desktop-app"
  ],
  "author": "SnSworker Team",
  "license": "MIT",
