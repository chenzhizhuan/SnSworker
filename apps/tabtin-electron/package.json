      "!node_modules/roarr/**",
      "!node_modules/@napi-rs/canvas-win32-*/**",
      "!node_modules/@napi-rs/canvas-linux-*/**",
      "!node_modules/@napi-rs/canvas-android-*/**",
      "!node_modules/@anush008/tokenizers-android-*/**",
      "!node_modules/@anush008/tokenizers-freebsd-*/**",
      "!node_modules/@img/sharp-win32-*/**",
      "!node_modules/@img/sharp-linux*/**",
      "!node_modules/@img/sharp-libvips-win32-*/**",
      "!node_modules/@img/sharp-libvips-linux*/**",
      "!node_modules/.pnpm/**/node_modules/global",
