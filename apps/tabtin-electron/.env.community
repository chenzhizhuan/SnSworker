# Community is a local-first distribution. The build script may override these
# public endpoints for another self-hosted server, but never falls back to a
# SnSworker company service.
VITE_API_BASE_URL=http://127.0.0.1:6060/api
TABTIN_API_BASE_URL=${VITE_API_BASE_URL}
VITE_IM_API_BASE_URL=${VITE_API_BASE_URL}
TABTIN_WS_BASE_URL=ws://127.0.0.1:6060
VITE_WS_BASE_URL=${TABTIN_WS_BASE_URL}
VITE_CENTRIFUGO_WS_URL=ws://127.0.0.1:8100/connection/websocket
VITE_COLLAB_WS_BASE=ws://127.0.0.1:4100
VITE_PUBLIC_WEB_BASE_URL=http://127.0.0.1:6060
VITE_WEBSITE_BASE_URL=http://127.0.0.1:6060

VITE_DISTRIBUTION_KIND=community
VITE_BUILD_PROFILE=community
VITE_SENTRY_DSN=
SENTRY_URL=
SOURCEMAP_API_URL=

# ---------- 功能全开（2026-09-10 专哥确认：以后打包默认全面开启所有功能）----------
# 以下开关在 community 下默认关（因 IS_DEV_LIKE_BUILD=false），显式注入 true 开启
VITE_ENABLE_PROJECTS_UI=true
VITE_ENABLE_DEBUG_PANELS=true
VITE_ENABLE_OPENAI_CODEX_BYOK_UI=true
DAEMON_CONTROL_ENABLED=true
# 浏览器容器：用 webview（与 production 一致）
VITE_TABTIN_BROWSER_CONTAINER=webview
# TabDoc 实时协作保存链路（Electron 端默认关，显式开启）
VITE_DOC_COLLAB_ENABLED=true

# ---------- 回收站 / 云文档文件面（2026-09-10 开启）----------
# 团队 Project 回收站：组织级面板 + team_space 回收入口（workspace 无回收站语义，入口自动隐藏）
VITE_ENABLE_TRASH_UI=true
# 云文档域展示普通文件（tabfiles）列表/筛选/上传；任务模式云盘本就不受影响
VITE_CLOUD_DOCS_SHOW_DRIVE=true

# ---------- 新增一级菜单：场景市场 / 经营看板 内置浏览器 URL ----------
VITE_SCENARIOS_URL=http://221.237.179.2:13490
VITE_ADMIN_DASH_URL=http://221.237.179.2:13491
