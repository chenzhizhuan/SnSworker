{
    "video_api": {
        "base_url": "https://ark.cn-beijing.volces.com",
        "task_create_path": "/api/v3/contents/generations/tasks",
        "task_query_path": "/api/v3/contents/generations/tasks",
        "img_create_path": "/api/v3/images/generations",
        "auth_header": "Authorization",
        "auth_prefix": "Bearer",
        "api_key_env": "ARK_API_KEY",
        "api_key_doc_url": "https://console.volcengine.com/ark"
    },
    "models": {
        "seedance-2.0": {
            "model_id": "doubao-seedance-2.0",
            "type": "video",
            "max_duration": 15,
            "default_duration": 5,
            "resolution": "720p",
            "ratios": ["16:9", "4:3", "1:1", "3:4", "9:16", "21:9", "adaptive"],
            "features": ["text2video", "img2video", "firstlast2video", "multimodal_ref", "audio_gen", "video_extend", "web_search"],
            "max_ref_images": 9,
            "max_ref_videos": 3,
            "max_ref_audios": 3,
            "description": "即梦 Seedance 2.0 满血版，多模态参考+音频同步+视频续写"
        },
        "seedance-2.0-fast": {
            "model_id": "doubao-seedance-2.0-fast",
            "type": "video",
            "max_duration": 15,
            "default_duration": 5,
            "resolution": "720p",
            "ratios": ["16:9", "4:3", "1:1", "3:4", "9:16", "21:9", "adaptive"],
            "features": ["text2video", "img2video", "firstlast2video", "multimodal_ref", "audio_gen", "web_search"],
            "max_ref_images": 9,
            "max_ref_videos": 3,
            "max_ref_audios": 3,
            "description": "即梦 Seedance 2.0 Fast，快速生成，成本低"
