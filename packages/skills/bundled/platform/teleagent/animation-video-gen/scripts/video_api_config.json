            "max_duration": 10,
            "default_duration": 5,
            "resolution": "720p",
            "ratios": ["16:9", "4:3", "1:1", "3:4", "9:16", "adaptive"],
            "features": ["text2video", "img2video", "firstlast2video"],
            "description": "即梦 Seedance 2.0 Mini，高性价比，不支持多模态参考"
        },
        "seedance-1.5-pro": {
            "model_id": "doubao-seedance-1.5-pro",
            "type": "video",
            "max_duration": 12,
            "default_duration": 5,
            "resolution": "1080p",
            "ratios": ["16:9", "4:3", "1:1", "3:4", "9:16", "21:9", "adaptive"],
            "features": ["text2video", "img2video", "firstlast2video", "draft_mode"],
